{
  "compilerOptions": {
    "target": "ES2021", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noUnusedLocals": false, "noImplicitOverride": true,
    "skipLibCheck": true, "isolatedModules": true, "types": ["vite/client", "node"], "resolveJsonModule": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
